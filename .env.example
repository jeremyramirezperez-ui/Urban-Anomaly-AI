# Base de datos: sqlite para prueba rápida o sqlserver para la entrega con SQL Server.
DB_TIPO=sqlite
SQLITE_RUTA=securityappcr.db

# SQL Server (se usa cuando DB_TIPO=sqlserver)
SQL_SERVER=localhost
SQL_DATABASE=BD-SecurityAPPCR
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_TRUSTED=true
SQL_USER=
SQL_PASSWORD=
SQL_ENCRYPT=yes
SQL_TRUST_CERTIFICATE=yes

# Correo SMTP. Para Gmail use una contraseña de aplicación.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=SecurityAPPCR
SMTP_USE_TLS=true

ZONA_HORARIA=America/Costa_Rica
CONFIANZA_MINIMA=0.45
TAMANO_MAX_IMAGEN_MB=8
INTERVALO_MONITOREO_MS=1200
